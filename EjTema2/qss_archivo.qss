/* Sintaxis igual que CSS:   selector { propiedad: valor; } */

QMainWindow {
    background-color: #eef2f7;
}

QLabel {
    color: #2c3e50;
    font-size: 20px;
    font-weight: bold;
}

QLineEdit {
    background-color: white;
    border: 1px solid #9aa5b1;
    border-radius: 5px;
    padding: 6px;
}

QCheckBox {
    color: #34495e;
}

QPushButton {
    background-color: #2e86de;
    color: white;
    border-radius: 5px;
    padding: 8px;
}
