/* Tema oscuro */
QMainWindow, .QWidget {
    background-color: #2b2b2b;
    color: #ecf0f1;
}

QLabel, QCheckBox {
    color: #ecf0f1;
}

QLineEdit, QTextEdit, QComboBox {
    background-color: #1e1e1e;
    color: #ecf0f1;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px;
}

QPushButton {
    background-color: #3c3f41;
    color: #ecf0f1;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px 14px;
}
QPushButton:hover {
    background-color: #4b6eaf;
}

QStatusBar {
    background-color: #1e1e1e;
    color: #bdc3c7;
}
