QLabel {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 14px;
    font-style: italic;
    font-weight: bold;
}

QPushButton{
    background-color: red;
}

QTextEdit{
    border: 5px solid green;
    margin: 20px;
    padding: 20px;
    border-radius: 20px;
}

